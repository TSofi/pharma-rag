# Copy this file to ".env" and fill in your keys. Never commit .env to GitHub.

# ---- LLM ----
LLM_PROVIDER=groq,gemini       # order of preference: groq (fast, free) | gemini | anthropic
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING=low           # minimal | low | medium | high (less thinking = faster)
LLM_TIMEOUT_S=30             # one Gemini call
GROQ_TIMEOUT_S=12            # one Groq call (it normally answers in 1-2 s)
LLM_DEADLINE_S=30            # all LLM calls of one question together; then the UI shows "busy, try again"
JUDGE_MODE=risky             # meaning check (2nd LLM call): risky = only risky topics | always | off
JUDGE_STRICT=true            # true: "not in the source" counts like a contradiction (-> repair -> orange)
# GEMINI_FALLBACK_MODELS=      # optional backups, comma-separated
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Vector DB ----
# Leave empty to use a local Qdrant folder (./qdrant_data). Fill in for Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=

# ---- Retrieval tuning ----
TOP_K=6
MIN_SCORE=0.62

# ---- Web ----
CORS_ORIGINS=*
# Questions per visitor (0 = off). Above the limit the user sees "busy, try again in N s" (HTTP 429).
ASK_LIMIT_PER_MINUTE=0       # off for now; suggested 10 once the client IP on Render is checked
ASK_LIMIT_PER_DAY=0          # off for now; suggested 200

# ---- "Report a problem" form (optional) ----
# Create a free account at resend.com, make an API key, and put your own e-mail here.
RESEND_API_KEY=
FEEDBACK_TO=
# Spam limits (0 = off). Resend's free plan: 100 e-mails a day, 3,000 a month -> 90 a day stays under both.
FEEDBACK_LIMIT_PER_HOUR=5
FEEDBACK_LIMIT_PER_DAY=90

# ---- Embeddings via Hugging Face Inference API (production, 512 MB server) ----
HF_TOKEN=
REMOTE_EMBED_MODELS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
